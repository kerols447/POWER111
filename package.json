{
  "name": "power111",
  "version": "1.0.0",
  "private": true,
  "description": "POWER 111 Gym Management System",
  "workspaces": [
    "server",
    "web",
    "shared"
  ],
  "scripts": {
    "postinstall": "npx prisma generate --schema=prisma/schema.prisma",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:web\"",
    "dev:server": "npm run dev --workspace=server",
    "dev:web": "npm run dev --workspace=web",
    "build": "npm run build --workspace=shared && npm run build --workspace=server && npm run build --workspace=web",
    "build:server": "npm run build --workspace=server",
    "build:web": "npm run build --workspace=web",
    "start": "node server/dist/index.js",
    "db:migrate": "npx prisma migrate dev --schema=prisma/schema.prisma",
    "db:migrate:prod": "npx prisma migrate deploy --schema=prisma/schema.prisma",
    "db:seed": "npx tsx scripts/seed.ts",
    "db:reset": "npx prisma migrate reset --schema=prisma/schema.prisma",
    "db:studio": "npx prisma studio --schema=prisma/schema.prisma",
    "test": "npm run test --workspace=server -- --run && npm run test --workspace=web -- --run",
    "test:server": "npm run test --workspace=server -- --run",
    "test:web": "npm run test --workspace=web -- --run",
    "test:e2e": "npm run test:e2e --workspace=web",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,css,md}\"",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "typescript": "^5.4.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "prettier": "^3.2.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
